# =============================================================================
# wael-app production environment — TEMPLATE ONLY
# =============================================================================
# The real file lives ONLY on the server at $WAEL_HOME/.env.production
# (mode 600, owner deploybot). It is never committed anywhere.
# Generate secrets with: openssl rand -hex 32
# scripts/preflight.sh rejects any value still containing PASTE_, CHANGE_ME
# or the dev default devpassword123.
# =============================================================================

# Public API hostname served by Caddy (DNS A/AAAA record must point here).
API_DOMAIN=api.elmetracademy.app
# Public admin hostname for the admin console, also served by Caddy (full host
# name, like API_DOMAIN). DNS must point at this host.
ADMIN_DOMAIN=admin.elmetracademy.app
ACME_EMAIL=PASTE_EMAIL_HERE
ALLOWED_ORIGIN=https://api.elmetracademy.app

# Shared secrets (openssl rand -hex 32). Different from every dev value.
# The services refuse to start (and fail --check-env) if one of these three
# is shorter than 32 bytes or contains PASTE_, CHANGE_ME or devpassword123.
JWT_SECRET=PASTE_64_HEX
GATEWAY_SECRET=PASTE_64_HEX
INTERNAL_SERVICE_TOKEN=PASTE_64_HEX

# MongoDB. Root password lives in $WAEL_HOME/secrets/mongo_root_password.
MONGO_ROOT_USERNAME=wael_root
# One least-privilege user per service (created once, see RUNBOOK.md step 6).
AUTH_MONGO_URI=mongodb://auth_svc:PASTE_PASSWORD@mongo:27017/auth_db?authSource=auth_db
NOTIFICATION_MONGO_URI=mongodb://notif_svc:PASTE_PASSWORD@mongo:27017/notification_db?authSource=notification_db
ACADEMY_MONGO_URI=mongodb://academy_svc:PASTE_PASSWORD@mongo:27017/academy_db?authSource=academy_db

# Redis. Must match requirepass in $WAEL_HOME/secrets/redis.conf.
REDIS_URI=redis://:PASTE_REDIS_PASSWORD@redis:6379/0

# Email delivery (required outside local/test since W-02).
RESEND_API_KEY=PASTE_RESEND_KEY
RESEND_FROM_EMAIL=no-reply@elmetracademy.app

# auth-service: key used to HMAC the blocked email and phone identities
# (SPEC R9). Required in production. openssl rand -hex 32. Do not rotate
# casually: existing blocklist entries stop matching.
BLOCKLIST_HMAC_KEY=PASTE_64_HEX
# Region used to normalise phone numbers entered without a country code.
DEFAULT_PHONE_REGION=EG

# academy-service: support WhatsApp number or link shown to students after an
# access request (ADR-0006). Required in production. International format.
SUPPORT_WHATSAPP=+PASTE_WHATSAPP_NUMBER
# Show subject prices to students (SPEC D3). Leave false unless the owner
# decides otherwise.
EXPOSE_PRICE_TO_STUDENTS=false

# academy-service public app config (F-UX2 A7): terms/privacy pages (https,
# required in production) and optional update metadata (empty = no prompt).
TERMS_URL=https://elmetracademy.app/terms
PRIVACY_URL=https://elmetracademy.app/privacy
# MIN_VERSION=
# LATEST_VERSION=
# UPDATE_URL=

# Optional tuning. Leave a value commented (or empty) to keep the service
# default shown here.
# academy-service per-user, per-minute limits:
# RATE_LIMIT_READ=120
# RATE_LIMIT_PLAY=60
# RATE_LIMIT_DOWNLOAD=10
# RATE_LIMIT_WRITE=5
# notification-service SSE limits:
# STREAM_MAX_CONCURRENT=3
# STREAM_OPEN_RATE_LIMIT=10

# -----------------------------------------------------------------------------
# Memory limits. The defaults in docker-compose.yml fit a 2 GB host:
#   caddy 128m, api-gateway 128m, auth-service 192m, notification-service 192m,
#   academy-service 192m, admin-console 64m, mongo 768m (WiredTiger cache
#   0.25 GB), redis 128m.
# Uncomment any of these to override one.
# -----------------------------------------------------------------------------
# CADDY_MEM_LIMIT=128m
# GATEWAY_MEM_LIMIT=128m
# AUTH_MEM_LIMIT=192m
# NOTIFICATION_MEM_LIMIT=192m
# ACADEMY_MEM_LIMIT=192m
# ADMIN_MEM_LIMIT=64m
# MONGO_MEM_LIMIT=768m
# MONGO_CACHE_GB=0.25
# REDIS_MEM_LIMIT=128m
# Redis data cap inside the container (below REDIS_MEM_LIMIT; see
# docker-compose.yml and SERVER-MANUAL.md §5). Policy is fixed to noeviction
# in the compose file and cannot be changed from here. Preflight fails if the
# rendered compose has no non-zero cap.
# REDIS_MAXMEMORY=96mb
# Go runtime heap caps (~85% of each container mem_limit; the Go runtime
# reads GOMEMLIMIT itself, no service config change needed):
# GATEWAY_GOMEMLIMIT=108MiB
# AUTH_GOMEMLIMIT=160MiB
# NOTIFICATION_GOMEMLIMIT=160MiB
# ACADEMY_GOMEMLIMIT=160MiB
# ADMIN_GOMEMLIMIT=54MiB

# -----------------------------------------------------------------------------
# 1 GB host: uncomment this whole block (and leave the 2 GB overrides above
# commented). The limits add up to about 980 MB, so the host needs swap and
# nothing else running on it. See RUNBOOK.md "Memory profiles".
# -----------------------------------------------------------------------------
# MONGO_CACHE_GB=0.25
# MONGO_MEM_LIMIT=420m
# REDIS_MEM_LIMIT=64m
# REDIS_MAXMEMORY=48mb
# GATEWAY_MEM_LIMIT=96m
# GATEWAY_GOMEMLIMIT=81MiB
# NOTIFICATION_MEM_LIMIT=96m
# NOTIFICATION_GOMEMLIMIT=81MiB
# ACADEMY_MEM_LIMIT=96m
# ACADEMY_GOMEMLIMIT=81MiB
# ADMIN_MEM_LIMIT=48m
# ADMIN_GOMEMLIMIT=40MiB
# AUTH_MEM_LIMIT=96m
# AUTH_GOMEMLIMIT=81MiB
# CADDY_MEM_LIMIT=64m

# Optional backup dead-man switch (scripts/backup.sh). A healthchecks.io (or
# compatible) check URL: GET on every verified backup, <url>/fail on failure.
# Set the check's period to 1 day and grace to a few hours so a missed nightly
# run alerts too. Empty = no ping.
# BACKUP_PING_URL=https://hc-ping.com/<uuid>
