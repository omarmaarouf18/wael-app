# wael-app edge proxy. Public TLS comes from Let's Encrypt for API_DOMAIN and
# ADMIN_DOMAIN; DNS for both must point at this host before the first deploy
# (the admin host only needs it before the console is used).
{
	email {$ACME_EMAIL}
}

{$API_DOMAIN} {
	# Caddy -> gateway is TLS verified against the local CA (SPEC Section 8
	# item 5). Never use tls_insecure_skip_verify here.
	reverse_proxy https://api-gateway:8080 {
		transport http {
			tls_trusted_ca_certs /certs/ca.crt
			tls_server_name api-gateway
		}
		# SSE: never buffer responses (notification stream).
		flush_interval -1
	}

	header {
		-Server
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
	}

	# No access log on purpose: the SSE stream still carries the JWT in
	# ?token= (SPEC Q9) and SPEC Section 8 item 8 forbids logging query
	# strings. The gateway logs requests without query strings.
}

# Admin console (SPEC Phase 6.1, ADR-0008). ADMIN_DOMAIN is the full host name,
# for example admin.elmetracademy.app.
{$ADMIN_DOMAIN} {
	# Same rule as the API host: the hop to the console is TLS verified against
	# the local CA. Caddy overwrites a client-supplied X-Forwarded-For; the
	# console reads it only from Caddy's fixed address (TRUSTED_PROXY_IPS).
	reverse_proxy https://admin-console:3005 {
		transport http {
			tls_trusted_ca_certs /certs/ca.crt
			tls_server_name admin-console
		}
	}

	header {
		-Server
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
	}

	# No access log on purpose: it would record who used the admin console and
	# when, and SPEC Section 8 item 8 forbids logging request details here.
}
