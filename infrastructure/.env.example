# =============================================================================
# wael-app — Local environment template (infrastructure/.env.example)
# =============================================================================
# Copy to infrastructure/.env.local and fill real values:
#   cp infrastructure/.env.example infrastructure/.env.local
# .env.local is git-ignored and never committed. Only this .example file is tracked.
#
# Values below are PLACEHOLDERS, except where a "LOCAL DEV ONLY" default is
# given (devpassword123). LOCAL DEV ONLY defaults must never appear in any
# staging/production file — generate production secrets with:
#   openssl rand -hex 32
# =============================================================================

# -----------------------------------------------------------------------------
# Database credentials
# -----------------------------------------------------------------------------
MONGO_INITDB_DATABASE=wael_platform
MONGO_INITDB_ROOT_USERNAME=root
# LOCAL DEV ONLY default. Production/staging: openssl rand -hex 24.
MONGO_INITDB_ROOT_PASSWORD=devpassword123

AUTH_MONGO_DATABASE=auth_db
ACADEMY_MONGO_DATABASE=academy_db

# MongoDB URI used by services (compose network).
# Pattern for local dev: mongodb://root:devpassword123@mongo:27017/?authSource=admin
MONGO_URI=mongodb://root:devpassword123@mongo:27017/?authSource=admin

# LOCAL DEV ONLY default. Production/staging: openssl rand -hex 24.
REDIS_PASSWORD=devpassword123

# Redis URI used by services (compose network).
# Pattern for local dev: redis://:devpassword123@redis:6379
REDIS_URI=redis://:devpassword123@redis:6379

# -----------------------------------------------------------------------------
# Ports (localhost dev)
# -----------------------------------------------------------------------------
API_GATEWAY_PORT=8080
AUTH_SERVICE_PORT=3002
ACADEMY_SERVICE_PORT=3003
NOTIFICATION_SERVICE_PORT=3004
ADMIN_CONSOLE_PORT=3005
# Internal admin listener (internal network only, no published host port)
ADMIN_LISTEN_ADDR=:9001

# Host-side published ports (override when the defaults are taken on your
# machine; container ports above stay unchanged).
MONGO_HOST_PORT=27017
REDIS_HOST_PORT=6380
GATEWAY_HOST_PORT=8080

# -----------------------------------------------------------------------------
# Inter-service URLs (compose network; https because local mTLS is on)
# -----------------------------------------------------------------------------
AUTH_SERVICE_URL=https://auth-service:3002
NOTIFICATION_SERVICE_URL=https://notification-service:3004
ACADEMY_SERVICE_URL=https://academy-service:3003

# -----------------------------------------------------------------------------
# App environment
# -----------------------------------------------------------------------------
# local | test | production. "local" enables dev OTP returns and verbose logs.
APP_ENV=local
LOG_LEVEL=info
ALLOWED_ORIGIN=http://localhost:3000
# Domain placeholder (no public domain yet; localhost-only, no Caddy locally).
APP_DOMAIN=localhost
TRUSTED_PROXY_IPS=127.0.0.1,::1,172.16.0.0/12,10.0.0.0/8

# -----------------------------------------------------------------------------
# Secrets — generate fresh values for .env.local, NEVER commit them.
# Generate via: openssl rand -hex 32
# -----------------------------------------------------------------------------
JWT_SECRET=PASTE_GENERATED_64_HEX_CHARS_HERE
GATEWAY_SECRET=PASTE_GENERATED_64_HEX_CHARS_HERE
INTERNAL_SERVICE_TOKEN=PASTE_GENERATED_64_HEX_CHARS_HERE

# -----------------------------------------------------------------------------
# Email delivery (required in production; empty = log-only sender, local/test only)
# -----------------------------------------------------------------------------
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# -----------------------------------------------------------------------------
# Blocklist & Auth security (required outside local/test)
# -----------------------------------------------------------------------------
BLOCKLIST_HMAC_KEY=PASTE_GENERATED_64_HEX_CHARS_HERE
DEFAULT_PHONE_REGION=EG
# Access-token lifetime (Go duration, 5m..24h). Unset means 24h.
# JWT_ACCESS_TTL=24h

# -----------------------------------------------------------------------------
# Notification stream limits (safe defaults: 3 concurrent streams, 10 opens/min)
# -----------------------------------------------------------------------------
STREAM_MAX_CONCURRENT=3
STREAM_OPEN_RATE_LIMIT=10

# -----------------------------------------------------------------------------
# Academy catalog configuration
# -----------------------------------------------------------------------------
EXPOSE_PRICE_TO_STUDENTS=false
SUPPORT_WHATSAPP=+201000000000

# -----------------------------------------------------------------------------
# Academy files (SPEC Phase 5, ADR-0009)
# -----------------------------------------------------------------------------
# 64 hex characters (openssl rand -hex 32). Empty is allowed for APP_ENV=local
# or test only and means an ephemeral key: files uploaded before a restart
# can no longer be opened. The files live in the academy_files volume.
DOCUMENT_ENCRYPTION_KEY=
# Max PDF upload in bytes (academy and console); empty means 20 MB (SPEC D14).
MAX_PDF_BYTES=
# "true" makes app-config send features.files=true (downloads in the app).
FEATURES_FILES=false
# Student PDF downloads in flight; more get 429 + Retry-After. Empty means 3.
MAX_CONCURRENT_DOWNLOADS=
# A download whose client stops reading this long is cut (Go duration
# 5s..5m). Empty means 30s.
DOWNLOAD_STALL_TIMEOUT=

# -----------------------------------------------------------------------------
# Academy rate limit tiers (requests/min per user, D13)
# -----------------------------------------------------------------------------
RATE_LIMIT_READ=120
RATE_LIMIT_PLAY=60
RATE_LIMIT_DOWNLOAD=10
RATE_LIMIT_WRITE=5
