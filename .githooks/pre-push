#!/bin/bash
# wael-app pre-push gate: gofmt, Go version drift, build/vet/test per
# module, gosec, govulncheck, contract tests, Flutter gates.
#
# The gate checks the commits being pushed, never the working tree. Git
# passes the pushed refs on stdin; every unique pushed SHA is checked once
# in a temporary detached worktree that is removed afterwards (on pass and
# on fail), so an unrelated uncommitted file can never block a push.
# Running the hook directly with no refs on stdin (as `make ci` does)
# checks the working tree instead.
set -e
run_gate_checks() {
echo "== pre-push gate: running checks =="

unset GIT_DIR GIT_WORK_TREE

# 1. Go formatting
UNFORMATTED=$(gofmt -l services shared tests tools 2>&1)
if [ -n "$UNFORMATTED" ]; then
  echo "BLOCKED: gofmt found unformatted files:"
  echo "$UNFORMATTED"
  exit 1
fi

# 2. Dart formatting (only when real Dart code exists)
if [ -d "frontend/lib" ]; then
  echo "-- checking frontend Dart formatting --"
  UNFORMATTED_DART=$(cd frontend && dart format --output=none --set-exit-if-changed lib/ test/ 2>&1) || {
    echo "BLOCKED: dart format found unformatted files:"
    echo "$UNFORMATTED_DART"
    exit 1
  }

  echo "-- checking frontend composition gate --"
  bash scripts/frontend_composition_gate.sh || {
    echo "BLOCKED: frontend composition gate failed"
    exit 1
  }

  echo "-- checking frontend composition gate self-test --"
  bash scripts/frontend_gate_test.sh || {
    echo "BLOCKED: frontend composition gate self-test failed"
    exit 1
  }
fi

# 3. Markdown commit SHAs must resolve to reachable commits
FAILED_SHA=0
for file in $(git ls-files '*.md'); do
  for sha in $(grep -oE "[0-9a-f]{40}" "$file" || true); do
    if ! git cat-file -e "$sha^{commit}" 2>/dev/null; then
      echo "BLOCKED: fabricated/non-existent SHA $sha in $file"
      FAILED_SHA=1
    elif ! git merge-base --is-ancestor "$sha" HEAD 2>/dev/null; then
      echo "BLOCKED: SHA $sha in $file is not reachable from current branch history"
      FAILED_SHA=1
    fi
  done
done
if [ "$FAILED_SHA" -eq 1 ]; then
  exit 1
fi

# 4. Go version drift guard (single pinned version everywhere)
echo "-- checking Go version consistency --"
CANONICAL_GO_VERSION="1.26.0"
CANONICAL_GO_PATCH_VERSION="1.26.9"
CANONICAL_GO_TOOLCHAIN="go1.26.9"
CANONICAL_GOSEC_VERSION="v2.29.0"
DRIFT_FAILED=0

for f in go.work services/*/go.mod shared/infra/go.mod tools/*/go.mod tests/*/go.mod; do
  if [ -f "$f" ]; then
    v=$(grep -E '^go [0-9]+\.[0-9]+' "$f" | head -n 1 | awk '{print $2}')
    if [ "$v" != "$CANONICAL_GO_VERSION" ]; then
      echo "BLOCKED: Go language version drift in $f: expected $CANONICAL_GO_VERSION, found '${v:-NONE}'"
      DRIFT_FAILED=1
    fi
    tc=$(grep -E '^toolchain go[0-9]+\.[0-9]+\.[0-9]+' "$f" | head -n 1 | awk '{print $2}')
    if [ "$tc" != "$CANONICAL_GO_TOOLCHAIN" ]; then
      echo "BLOCKED: Go toolchain version drift in $f: expected $CANONICAL_GO_TOOLCHAIN, found '${tc:-NONE}'"
      DRIFT_FAILED=1
    fi
  fi
done

if [ -f ".github/workflows/ci.yml" ]; then
  for v in $(grep -oE "go-version: '[0-9]+\.[0-9]+\.[0-9]+'" .github/workflows/ci.yml | grep -oE "[0-9]+\.[0-9]+\.[0-9]+"); do
    if [ "$v" != "$CANONICAL_GO_PATCH_VERSION" ]; then
      echo "BLOCKED: Go version drift in .github/workflows/ci.yml: expected $CANONICAL_GO_PATCH_VERSION, found '$v'"
      DRIFT_FAILED=1
    fi
  done
fi

for d in services/*/Dockerfile; do
  if [ -f "$d" ]; then
    for v in $(grep -oE "FROM golang:[0-9]+\.[0-9]+\.[0-9]+" "$d" | grep -oE "[0-9]+\.[0-9]+\.[0-9]+"); do
      if [ "$v" != "$CANONICAL_GO_PATCH_VERSION" ]; then
        echo "BLOCKED: Go version drift in $d: expected $CANONICAL_GO_PATCH_VERSION, found '$v'"
        DRIFT_FAILED=1
      fi
    done
  fi
done

if [ "$DRIFT_FAILED" -eq 1 ]; then
  exit 1
fi

# 4b. gosec pin must be identical in the hook and ci.yml. The hook's pin is
# CANONICAL_GOSEC_VERSION above; ci.yml carries the literal install ref.
HOOK_GOSEC="gosec/v2/cmd/gosec@$CANONICAL_GOSEC_VERSION"
CI_GOSEC=""
if [ -f ".github/workflows/ci.yml" ]; then
  CI_GOSEC=$(grep -oE "gosec/v2/cmd/gosec@v[0-9]+\.[0-9]+\.[0-9]+" .github/workflows/ci.yml | head -n 1)
fi
if [ -z "$CI_GOSEC" ] || [ "$HOOK_GOSEC" != "$CI_GOSEC" ]; then
  echo "BLOCKED: gosec pin mismatch: hook pins '$HOOK_GOSEC', ci.yml has '${CI_GOSEC:-NONE}'"
  exit 1
fi

# 5. Build/vet/test per module + security scans on real-code modules
GOSEC_BIN=$(which gosec 2>/dev/null || ls ~/go/bin/gosec 2>/dev/null || echo "")
if [ -z "$GOSEC_BIN" ] && [ -d "$HOME/go/bin" ]; then
  GOSEC_BIN="$HOME/go/bin/gosec"
fi

GOVULNCHECK_BIN=$(which govulncheck 2>/dev/null || ls ~/go/bin/govulncheck 2>/dev/null || echo "")
if [ -z "$GOVULNCHECK_BIN" ] && [ -d "$HOME/go/bin" ]; then
  GOVULNCHECK_BIN="$HOME/go/bin/govulncheck"
fi

for mod in services/academy-service services/admin-console services/api-gateway services/auth-service services/notification-service shared/infra tools/docgen tests/contracts tests/e2e; do
  echo "-- checking $mod --"
  (cd "$mod" && go build ./... && GOWORK=off go build ./... && go vet ./... && go test -race ./... -count=1) || {
    echo "BLOCKED: $mod failed build/vet/test"
    exit 1
  }
done

for mod in services/academy-service services/admin-console services/api-gateway services/auth-service services/notification-service shared/infra; do
  if [ -z "$GOVULNCHECK_BIN" ] || [ ! -x "$GOVULNCHECK_BIN" ]; then
    echo "govulncheck not found, installing..."
    go install golang.org/x/vuln/cmd/govulncheck@latest 2>/dev/null || true
    GOVULNCHECK_BIN="$HOME/go/bin/govulncheck"
  fi
  if [ -x "$GOVULNCHECK_BIN" ]; then
    echo "-- running govulncheck on $mod --"
    VULN_OUT=$( (cd "$mod" && "$GOVULNCHECK_BIN" -format json ./...) || true)

    STDLIB_VULNS=$(echo "$VULN_OUT" | jq -r 'select(.finding != null and (.finding.trace | any(.package != null and (.package | startswith("github.com/omarmaarouf18/wael-app/")))) and .finding.trace[0].module == "stdlib") | .finding.osv' | sort -u)
    if [ -n "$STDLIB_VULNS" ]; then
      for id in $STDLIB_VULNS; do
        echo "WARNING: SKIPPED ($id) (stdlib vulnerability) — verify local Go patch version"
      done
    fi

    NON_STDLIB_VULNS=$(echo "$VULN_OUT" | jq -c 'select(.finding != null and (.finding.trace | any(.package != null and (.package | startswith("github.com/omarmaarouf18/wael-app/")))) and .finding.trace[0].module != "stdlib")')
    if [ -n "$NON_STDLIB_VULNS" ]; then
      echo "BLOCKED: $mod failed govulncheck security scan with third-party vulnerabilities:"
      echo "$NON_STDLIB_VULNS" | jq .
      exit 1
    fi
  else
    echo "BLOCKED: govulncheck is required but could not be installed/found. Install via: go install golang.org/x/vuln/cmd/govulncheck@latest"
    exit 1
  fi

  if [ -z "$GOSEC_BIN" ] || [ ! -x "$GOSEC_BIN" ]; then
    echo "gosec not found, installing $CANONICAL_GOSEC_VERSION..."
    go install "github.com/securego/gosec/v2/cmd/gosec@$CANONICAL_GOSEC_VERSION" 2>/dev/null || true
    GOSEC_BIN="$HOME/go/bin/gosec"
  fi
  if [ -x "$GOSEC_BIN" ]; then
    echo "-- running gosec on $mod --"
    (cd "$mod" && "$GOSEC_BIN" ./...) || {
      echo "BLOCKED: $mod failed gosec security scan"
      exit 1
    }
  else
    echo "BLOCKED: gosec is required but could not be installed/found. Install via: go install github.com/securego/gosec/v2/cmd/gosec@$CANONICAL_GOSEC_VERSION"
    exit 1
  fi
done

# 5b. Admin console browser-side tests (node:test, no npm packages)
echo "-- running admin console web tests (node --test) --"
if ! command -v node >/dev/null 2>&1; then
  echo "BLOCKED: node is required for services/admin-console/web tests (Node 20 or newer)"
  exit 1
fi
(cd services/admin-console && node --test web/test/*.test.mjs) || {
  echo "BLOCKED: services/admin-console web tests failed"
  exit 1
}

# 5c. Certificate script self-test (--sign-only must keep the CA and other certs)
echo "-- running certificate script tests --"
bash scripts/generate_certs_test.sh || {
  echo "BLOCKED: scripts/generate_certs_test.sh failed"
  exit 1
}

# 5d. Deploy script tests (rollback correctness, orphans, failed-releases guard)
echo "-- running deploy script tests --"
bash scripts/deploy_scripts_test.sh || {
  echo "BLOCKED: scripts/deploy_scripts_test.sh failed"
  exit 1
}

# 6. Contract tests
echo "-- running contract tests (tests/contracts) --"
(cd tests/contracts && go test -v -count=1 ./...) || {
  echo "BLOCKED: tests/contracts failed"
  exit 1
}

# 7. Flutter analyze & test
if [ -d "frontend/lib" ]; then
  echo "-- checking frontend Flutter analyze/test --"
  (cd frontend && flutter analyze && flutter test) || {
    echo "BLOCKED: frontend failed analyze or test checks"
    exit 1
  }
fi

echo "== pre-push gate: all checks passed =="
}

# Temporary worktrees for the pushed SHAs. Created in main(), removed by the
# EXIT trap on both pass and fail.
_PRE_PUSH_TMP_ROOT=""
_PRE_PUSH_REPO_ROOT=""

cleanup_push_worktrees() {
  if [ -z "$_PRE_PUSH_TMP_ROOT" ]; then
    return 0
  fi
  local w
  for w in "$_PRE_PUSH_TMP_ROOT"/wt-*; do
    if [ -e "$w" ]; then
      git -C "$_PRE_PUSH_REPO_ROOT" worktree remove --force "$w" >/dev/null 2>&1 || rm -rf "$w"
    fi
  done
  rm -rf "$_PRE_PUSH_TMP_ROOT"
  _PRE_PUSH_TMP_ROOT=""
}

main() {
  local line local_ref local_sha remote_ref remote_sha s
  local shas="" seen="" sha_list=""
  local zero="0000000000000000000000000000000000000000"

  if [ -t 0 ]; then
    shas=""
  else
    while IFS= read -r line || [ -n "$line" ]; do
      [ -z "$line" ] && continue
      read -r local_ref local_sha remote_ref remote_sha <<<"$line"
      [ -z "${local_sha:-}" ] && continue
      [ "$local_sha" = "$zero" ] && continue
      shas="$shas $local_sha"
    done
  fi

  # No refs on stdin (direct run, as `make ci` does): check the working tree.
  if [ -z "$shas" ]; then
    echo "== pre-push gate: no refs on stdin; checking the working tree =="
    run_gate_checks
    return "$?"
  fi

  # Two refs pointing at the same SHA are checked once.
  for s in $shas; do
    case " $seen " in
      *" $s "*) continue ;;
    esac
    seen="$seen $s"
    sha_list="$sha_list $s"
  done

  _PRE_PUSH_REPO_ROOT="$(git rev-parse --show-toplevel)"
  _PRE_PUSH_TMP_ROOT="$(mktemp -d)"
  trap cleanup_push_worktrees EXIT

  local n=0 wt
  for s in $sha_list; do
    n=$((n + 1))
    wt="$_PRE_PUSH_TMP_ROOT/wt-$n"
    echo "== pre-push gate: checking pushed commit $s in a temporary worktree =="
    if ! git -C "$_PRE_PUSH_REPO_ROOT" worktree add --detach "$wt" "$s" >/dev/null; then
      echo "BLOCKED: cannot check out pushed commit $s"
      return 1
    fi
    if ! ( cd "$wt" && run_gate_checks ); then
      echo "BLOCKED: pushed commit $s failed the gate"
      return 1
    fi
  done

  echo "== pre-push gate: all pushed commits passed =="
  return 0
}

# Sourced by scripts/pre_push_hook_test.sh with PRE_PUSH_SOURCED=1 so the
# test can stub run_gate_checks and drive main() with fake ref lines.
if [ "${PRE_PUSH_SOURCED:-}" != "1" ]; then
  main "$@"
fi
